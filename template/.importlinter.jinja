[importlinter]
root_packages =
    {{ package_name }}
include_external_packages = True

[importlinter:contract:core_domain_isolation]
name = core_domain_isolation
type = forbidden
source_modules =
    {{ package_name }}.core.domain
forbidden_modules =
    {{ package_name }}.adapters
    external
    frameworks

[importlinter:contract:inward_dependency_direction]
name = inward_dependency_direction
type = layers
layers =
    {{ package_name }}.adapters
    {{ package_name }}.core.use_cases
    {{ package_name }}.core.domain

[importlinter:contract:domain_port_isolation]
name = domain_port_isolation
type = forbidden
source_modules =
    {{ package_name }}.core.domain
forbidden_modules =
    {{ package_name }}.core.ports
    {{ package_name }}.core.use_cases

[importlinter:contract:use_case_transport_isolation]
name = use_case_transport_isolation
type = forbidden
source_modules =
    {{ package_name }}.core.use_cases
forbidden_modules =
    {{ package_name }}.adapters
    fastapi
    starlette
    flask
    click
    typer

[importlinter:contract:composition_root_isolation]
name = composition_root_isolation
type = forbidden
source_modules =
    {{ package_name }}.core.domain
    {{ package_name }}.core.ports
    {{ package_name }}.core.use_cases
    {{ package_name }}.adapters
forbidden_modules =
    {{ package_name }}.bootstrap

[importlinter]
root_packages =
    core
    adapters

[importlinter:contract:core_domain_isolation]
name = core_domain_isolation
type = forbidden
source_modules =
    core.domain
forbidden_modules =
    adapters
    external
    frameworks

[importlinter:contract:inward_dependency_direction]
name = inward_dependency_direction
type = layers
layers =
    adapters
    core.use_cases
    core.domain

[importlinter:contract:domain_port_isolation]
name = domain_port_isolation
type = forbidden
source_modules =
    core.domain
forbidden_modules =
    core.ports
    core.use_cases

[importlinter]
root_packages =
    core
    adapters

[importlinter:contract:core_domain_isolation]
name = core_domain_isolation
type = forbidden
source_modules =
    core.domain
forbidden_modules =
    adapters
    external
    frameworks

[importlinter:contract:inward_dependency_direction]
name = inward_dependency_direction
type = layers
layers =
    adapters
    core.use_cases
    core.domain

[importlinter:contract:domain_port_isolation]
name = domain_port_isolation
type = forbidden
source_modules =
    core.domain
forbidden_modules =
    core.ports
    core.use_cases

[importlinter:contract:use_case_transport_isolation]
name = use_case_transport_isolation
type = forbidden
source_modules =
    core.use_cases
forbidden_modules =
    adapters
    fastapi
    starlette
    flask
    click
    typer

[importlinter:contract:composition_root_isolation]
name = composition_root_isolation
type = forbidden
source_modules =
    core.domain
    core.ports
    core.use_cases
    adapters
forbidden_modules =
    bootstrap
